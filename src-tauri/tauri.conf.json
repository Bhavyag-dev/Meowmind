{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meowmind",
  "version": "0.1.0",
  "identifier": "com.meowmind.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "companion",
        "title": "Meowmind",
        "url": "/",
        "width": 380,
        "height": 450,
        "minWidth": 250,
        "minHeight": 250,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "settings",
        "title": "Meowmind Settings",
        "url": "/settings",
        "width": 600,
        "height": 700,
        "minWidth": 500,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "trayIcon": {
      "id": "meowmind-tray",
      "iconPath": "icons/32x32.png",
      "tooltip": "Meowmind"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": []
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
